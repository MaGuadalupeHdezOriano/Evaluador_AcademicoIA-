@page
@model EvaluadorAcademico.Web.Pages.CapturarModel

<h1>Capturar Calificación</h1>

<form method="post">

    <div class="mb-3">
        <label>Matrícula</label>
        <input asp-for="Evaluacion.Matricula"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Asistencia</label>
        <input asp-for="Evaluacion.Asistencia"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Actividades</label>
        <input asp-for="Evaluacion.Actividades"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Prácticas</label>
        <input asp-for="Evaluacion.Practicas"
               class="form-control" />
    </div>

    <div class="mb-3">
        <label>Examen</label>
        <input asp-for="Evaluacion.Examen"
               class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">
        Calcular
    </button>

</form>

@if (Model.Calificacion100 > 0)
{
    <hr />

    <h3>Resultado</h3>

    <p>
        Calificación (0-100):
        <strong>@Model.Calificacion100</strong>
    </p>

    <p>
        Calificación (0-10):
        <strong>@Model.Calificacion10</strong>
    </p>
}