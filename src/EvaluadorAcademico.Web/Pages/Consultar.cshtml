@page
@model ConsultarModel

<h1>Consultar Alumno</h1>

<form method="post">

    <div class="mb-3">
        <label>Matrícula</label>

        <input asp-for="Matricula"
               class="form-control" />
    </div>

    <button type="submit"
            class="btn btn-primary">
        Buscar
    </button>

</form>

@if (Model.Alumno != null)
{
    <hr />

    <h3>Información del Alumno</h3>

    <p>
        <strong>Matrícula:</strong>
        @Model.Alumno.Matricula
    </p>

    <p>
        <strong>Nombre:</strong>
        @Model.Alumno.Nombre
    </p>

    <p>
        <strong>Grupo:</strong>
        @Model.Alumno.Grupo
    </p>

    <p>
        <strong>Asignatura:</strong>
        @Model.Alumno.Asignatura
    </p>

    <p>
        <strong>Estatus:</strong>
        @Model.Alumno.Estatus
    </p>
}