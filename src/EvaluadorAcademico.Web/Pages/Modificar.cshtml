@page
@model ModificarModel

<h1>Modificar Calificación</h1>

<form method="post">

    <div class="mb-3">
        <label>Matrícula</label>

        <input asp-for="Matricula"
               class="form-control" />
    </div>

    <button asp-page-handler="Buscar"
            class="btn btn-primary">

        Buscar Evaluación

    </button>

</form>

@if (!string.IsNullOrEmpty(Model.Evaluacion.Matricula))
{
    <hr />

    <h3>Evaluación Encontrada</h3>

    <form method="post">

        <input asp-for="Evaluacion.Matricula"
               type="hidden" />

        <div class="mb-3">
            <label>Asistencia</label>

            <input asp-for="Evaluacion.Asistencia"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Actividades</label>

            <input asp-for="Evaluacion.Actividades"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Prácticas</label>

            <input asp-for="Evaluacion.Practicas"
                   class="form-control" />
        </div>

        <div class="mb-3">
            <label>Examen</label>

            <input asp-for="Evaluacion.Examen"
                   class="form-control" />
        </div>

        <button asp-page-handler="Guardar"
                class="btn btn-success">

            Guardar Cambios

        </button>

    </form>
}
